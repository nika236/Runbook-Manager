# ── Platform-managed (set automatically on deploy — do not provide in custom secrets) ──

HOST=0.0.0.0
PORT=4747

# ── Confluence API (read-only) ──

CONFLUENCE_BASE_URL=           # e.g. https://your-site.atlassian.net
CONFLUENCE_SITE_BASE_URL=      # e.g. https://your-site.atlassian.net/wiki (auto-derived if blank)
CONFLUENCE_EMAIL=              # Atlassian account email for API auth
CONFLUENCE_API_TOKEN=          # Atlassian API token (read-only scope)
CONFLUENCE_SPACE_KEYS=         # Comma-separated space keys, e.g. SPACEA,SPACEB
CONFLUENCE_CLOUD_ID=           # Confluence Cloud ID (optional)

# ── Application settings ──

SECRET_KEY=                    # Flask secret key (auto-generated if blank)
STALE_THRESHOLD_DAYS=30        # Days before content is flagged as technically stale
REVIEW_AGE_DAYS=365            # Days before content is flagged for review
DATA_DIR=data                  # Local data directory (mapped to /data in production)
CONFLUENCE_RATE_LIMIT=8        # Max Confluence API requests per second
